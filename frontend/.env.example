NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional. A permitted MapLibre style URL from your own satellite imagery provider,
# e.g. a MapTiler Satellite style URL with a domain-restricted free-tier public key.
# Without this, the map uses OpenStreetMap street tiles with attribution.
NEXT_PUBLIC_SATELLITE_STYLE_URL=

# Optional MapTiler browser-safe public key (restrict to website origin).
# When set, the 3D campus defaults to a licensed MapTiler satellite-v4 style.
NEXT_PUBLIC_MAPTILER_KEY=
