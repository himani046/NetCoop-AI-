NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional. A permitted MapLibre style URL from your own satellite imagery provider,
# e.g. a MapTiler Satellite style URL with a domain-restricted free-tier public key.
# Without this, the map uses OpenStreetMap street tiles with attribution.
NEXT_PUBLIC_SATELLITE_STYLE_URL=

# Optional MapTiler browser-safe public key (restrict to website origin).
# When set, the 3D campus defaults to a licensed MapTiler satellite-v4 style.
NEXT_PUBLIC_MAPTILER_KEY=

# Sentinel Hub / Copernicus WMS (browser-side instance ID only; no OAuth secret)
# Create a WMS configuration instance with a NATURAL-COLOR layer.
# Instance ID is used in public WMS requests; evaluate quotas and usage terms.
NEXT_PUBLIC_SENTINEL_INSTANCE_ID=
NEXT_PUBLIC_SENTINEL_LAYER=NATURAL-COLOR
# Set "copernicus" to use sh.dataspace.copernicus.eu, else commercial Sentinel Hub.
NEXT_PUBLIC_SENTINEL_WMS_BASE=
# Optional scene acquisition date/range (YYYY-MM-DD or YYYY-MM-DD/YYYY-MM-DD)
NEXT_PUBLIC_SENTINEL_TIME=
